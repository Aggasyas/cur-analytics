# ===== Настройки MAX-бота аналитики ЦУР =====
# Скопируйте этот файл в .env.max и заполните своими значениями.
# Файл .env.max в репозиторий НЕ коммитится (он в .gitignore).

# Токен MAX-бота (business.max.ru → ваш бот → Интеграция → Получить токен).
# НЕ Telegram-токен! Это отдельный токен из мессенджера MAX.
MAX_BOT_TOKEN=ВАШ_ТОКЕН_MAX_БОТА

# Публичный адрес сайта на GitHub Pages (без слэша в конце).
PAGES_URL=https://aggasyas.github.io/cur-analytics

# Кому разрешено присылать файлы в личке боту — MAX user_id через запятую.
# Узнать свой user_id: напишите боту любое сообщение и посмотрите логи сервиса
# (journalctl -u cur-max-bot -f) — там будет sender user_id. Пусто = разрешено всем.
ALLOWED_IDS=

# Разрешённые групповые чаты (id чатов МАХ через запятую), где бот ловит файлы.
# Бот должен быть АДМИНОМ группы, иначе не видит сообщения.
ALLOWED_CHAT_IDS=

# Куда присылать результат, если файл пришёл в группе. Пусто = в тот же чат.
REPORT_CHAT_ID=

# Какие файлы принимать в группе (регулярка по имени). По умолчанию — любой .xlsx.
# Рабочий формат — накопительная выгрузка nr-01.01.26-….xlsx:
# NAME_FILTER=nr.*\.xlsx$

# (необязательно) Папка сайта и корень git-репозитория. Обычно менять не нужно.
# SITE_DIR=/opt/cur-analytics/docs
# GIT_REPO_DIR=/opt/cur-analytics
