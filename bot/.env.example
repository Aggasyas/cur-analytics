# ===== Бот ЦУР — настройки окружения =====
# Скопируйте этот файл в .env и подставьте свои значения:
#   cp .env.example .env && nano .env

# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО). Создайте ОТДЕЛЬНОГО бота от бота ЕДДС!
BOT_TOKEN=123456789:ABCDEF_ваш_новый_токен_от_BotFather

# Адрес опубликованного сайта на GitHub Pages (без слэша на конце)
PAGES_URL=https://aggasyas.github.io/cur-analytics

# Корень git-репозитория (куда склонирован cur-analytics)
GIT_REPO_DIR=/opt/cur

# Папка с готовым сайтом и файл истории (по умолчанию внутри GIT_REPO_DIR)
SITE_DIR=/opt/cur/docs
HISTORY=/opt/cur/cur_history.jsonl

# Кто может управлять ботом и получать сводки в личке — ваши Telegram-ID
# (узнать свой id: напишите боту @userinfobot). Через запятую: вы + руководитель ЦУР.
ALLOWED_IDS=111111111,222222222

# id чата ЦУР (отрицательное число, начинается с -100...).
# Только из этого чата бот будет принимать выгрузки.
ALLOWED_CHAT_IDS=-1001234567890

# Куда бот публикует готовую сводку в ответ на файл из группы.
# Обычно — тот же чат ЦУР. Можно оставить пустым (ответит в тот чат, откуда пришёл файл).
REPORT_CHAT_ID=-1001234567890

# Какие файлы принимать (регулярное выражение по имени). По умолчанию — любой .xlsx.
# Рабочий формат — накопительная выгрузка с начала года с именем вида nr-01.01.26-03.06.2026.xlsx.
# Чтобы ловить только такие файлы — раскомментируйте:
# NAME_FILTER=nr.*\.xlsx$
